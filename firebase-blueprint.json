{
  "entities": {
    "User": {
      "title": "User",
      "description": "Customer and administrator profiles for Un Moment pour Soi",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique identifier of the user matching Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Full name of the user"
        },
        "phone": {
          "type": "string",
          "maxLength": 25,
          "description": "Contact phone number"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Whether the user is an admin / practitioner"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "client"],
          "description": "Access role"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the email was verified via sendEmailVerification"
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp"
        }
      },
      "required": ["userId", "email"]
    },
    "Service": {
      "title": "Service",
      "description": "Beauty treatment or ritual offered by the salon, managed by administrators",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique slug or ID of the service"
        },
        "title": {
          "type": "string",
          "maxLength": 120,
          "description": "Title of the service"
        },
        "subtitle": {
          "type": "string",
          "maxLength": 150,
          "description": "Short catchphrase"
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Category identifier"
        },
        "categoryName": {
          "type": "string",
          "maxLength": 80,
          "description": "Human-readable category label"
        },
        "durationMinutes": {
          "type": "number",
          "description": "Duration in minutes"
        },
        "price": {
          "type": "number",
          "description": "Price in Euros"
        },
        "originalPrice": {
          "type": "number",
          "description": "Original price if on promotion"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Detailed treatment description"
        },
        "recommendedFor": {
          "type": "string",
          "maxLength": 300,
          "description": "Skin or body indication"
        },
        "badge": {
          "type": "string",
          "maxLength": 50,
          "description": "Promotional badge"
        },
        "image": {
          "type": "string",
          "maxLength": 500,
          "description": "Cover image URL"
        },
        "active": {
          "type": "boolean",
          "description": "Whether offer is published on website"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["title", "category", "durationMinutes", "price", "description"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Appointment booking for a beauty treatment",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User ID of the client who booked the appointment"
        },
        "customerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Client full name"
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "description": "Client email"
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 25,
          "description": "Client phone number"
        },
        "serviceId": {
          "type": "string",
          "maxLength": 50,
          "description": "Identifier of the selected beauty service"
        },
        "serviceTitle": {
          "type": "string",
          "maxLength": 100,
          "description": "Title of the service"
        },
        "serviceCategory": {
          "type": "string",
          "maxLength": 50,
          "description": "Category of the beauty service"
        },
        "durationMinutes": {
          "type": "number",
          "description": "Duration in minutes"
        },
        "price": {
          "type": "number",
          "description": "Price in Euros (€)"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Appointment date (YYYY-MM-DD)"
        },
        "timeSlot": {
          "type": "string",
          "maxLength": 20,
          "description": "Appointment time slot (e.g. 10:00)"
        },
        "practitioner": {
          "type": "string",
          "maxLength": 80,
          "description": "Selected aesthetician or therapist"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Customer special notes or preferences"
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "cancelled", "completed"],
          "description": "Status of the appointment"
        },
        "cancellationReason": {
          "type": "string",
          "maxLength": 250,
          "description": "Reason given if cancelled"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "customerName", "serviceId", "serviceTitle", "price", "date", "timeSlot", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Client review and testimonial for salon treatments",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the author"
        },
        "userName": {
          "type": "string",
          "maxLength": 80,
          "description": "Display name of reviewer"
        },
        "serviceTitle": {
          "type": "string",
          "maxLength": 100,
          "description": "Service reviewed"
        },
        "rating": {
          "type": "number",
          "description": "Rating score between 1 and 5"
        },
        "comment": {
          "type": "string",
          "maxLength": 500,
          "description": "Review text"
        },
        "createdAt": {
          "type": "string",
          "description": "Review publication timestamp"
        }
      },
      "required": ["userId", "userName", "rating", "comment"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Customer and practitioner profiles"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Catalog of salon treatments and offerings, manageable by admins"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Client bookings, accessible to the client and admins"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Client reviews and testimonials"
    }
  }
}
