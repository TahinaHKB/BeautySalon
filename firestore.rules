rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tahinaAndriantsoa2004@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'customerName', 'serviceId', 'serviceTitle', 'price', 'date', 'timeSlot', 'status', 'paymentStatus']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.serviceId is string && data.serviceId.size() <= 50 &&
             data.serviceTitle is string && data.serviceTitle.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.date is string && data.date.size() <= 20 &&
             data.timeSlot is string && data.timeSlot.size() <= 20 &&
             data.status in ['confirmed', 'cancelled', 'completed'] &&
             data.paymentStatus in ['paid', 'refunded', 'pending'] &&
             (!('durationMinutes' in data) || (data.durationMinutes is number && data.durationMinutes > 0)) &&
             (!('serviceCategory' in data) || (data.serviceCategory is string && data.serviceCategory.size() <= 80)) &&
             (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 150)) &&
             (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 25)) &&
             (!('practitioner' in data) || (data.practitioner is string && data.practitioner.size() <= 80)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('cancellationReason' in data) || (data.cancellationReason is string && data.cancellationReason.size() <= 250)) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50)) &&
             (!('paymentTransactionId' in data) || (data.paymentTransactionId is string && data.paymentTransactionId.size() <= 100)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['userId', 'userName', 'rating', 'comment']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 80 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 500 &&
             (!('serviceTitle' in data) || (data.serviceTitle is string && data.serviceTitle.size() <= 100)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40));
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().userId == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && incoming().userId == userId && isValidUser(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'email', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        isAdmin() || (resource.data.userId == request.auth.uid)
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidBooking(incoming());
      allow update: if isSignedIn() && isValidBooking(incoming()) && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().userId == existing().userId && (
          // Action: Cancel Booking
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellationReason', 'updatedAt']) && incoming().status == 'cancelled') ||
          // Action: Reschedule / modify notes
          (incoming().diff(existing()).affectedKeys().hasOnly(['date', 'timeSlot', 'notes', 'updatedAt']) && existing().status == 'confirmed')
        ))
      );
      allow delete: if isAdmin();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidReview(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId && isValidReview(incoming());
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }
  }
}
